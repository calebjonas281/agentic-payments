# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Anthropic (required for the agent loop)
ANTHROPIC_API_KEY=

# Lightning / MoneyDevKit wallet
AP_DEMO_MODE=true
AP_DEMO_BALANCE_SATS=50000
AP_DAILY_BUDGET_SATS=1000

# Stripe — card-funded wallet top-ups with automatic tax (Stripe Tax)
# Get test keys from https://dashboard.stripe.com/test/apikeys
# Create the webhook (checkout.session.completed) at https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
AP_SATS_PER_USD=1500
AP_BASE_URL=http://localhost:8000
